# Gmail example: use a Google App Password, not your normal account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=ATAS Alerts <alerts@example.com>
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password

ALERT_EMAIL=alerts@example.com

# Backend-only Supabase alert queue credentials. Never use these in VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ATAS_WEBHOOK_SECRET=replace-with-a-random-secret

# Heatmap and alerting policy
RISK_THRESHOLD_HEATMAP=60
ALERT_COOLDOWN_MINUTES=5

# Activity recognition diagnostics (does not alter the UI).
ACTIVITY_MIN_CONFIDENCE=0.50
ACTIVITY_DEBUG=false

# Potentially dangerous object detection
OBJECT_DETECTION_CONFIDENCE=0.35
OPEN_VOCAB_SHARP_CONFIDENCE=0.35
OBJECT_CONFIRMATION_FRAMES=3

# Reset links are built from this frontend origin.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRY_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_MINUTES=15
